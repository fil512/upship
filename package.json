{
  "name": "upship",
  "version": "1.0.0",
  "description": "UP SHIP! - A strategy board game about airship conglomerates during the Golden Age of Airships",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "migrate:down": "node server/db/migrate.js down",
    "migrate:status": "node server/db/migrate.js status",
    "cli": "node cli/upship.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "bin": {
    "upship": "./cli/upship.js"
  },
  "keywords": [
    "boardgame",
    "airship",
    "strategy"
  ],
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.4"
  }
}
