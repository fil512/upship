{
  "name": "upship",
  "version": "1.0.0",
  "description": "UP SHIP! - A strategy board game about airship conglomerates during the Golden Age of Airships",
  "main": "server/index.js",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "start": "node server/index.js",
    "build": "npm run build --workspace=web",
    "dev": "node --watch server/index.js",
    "dev:local": "DOTENV_CONFIG_PATH=.env.development node -r dotenv/config --watch server/index.js",
    "dev:web": "npm run dev --workspace=web",
    "dev:all": "concurrently \"npm run dev:local\" \"npm run dev:web\"",
    "build:web": "npm run build --workspace=web",
    "migrate": "node server/db/migrate.js",
    "migrate:down": "node server/db/migrate.js down",
    "migrate:status": "node server/db/migrate.js status",
    "migrate:local": "DOTENV_CONFIG_PATH=.env.development node -r dotenv/config server/db/migrate.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "dev:setup": "npm run db:up && sleep 2 && npm run migrate:local && npm run dev:local",
    "cli": "client/.env/bin/python3 cli/upship_cli.py",
    "cli:local": "UPSHIP_URL=http://localhost:3000 client/.env/bin/python3 cli/upship_cli.py",
    "cli:js": "node cli/upship.js",
    "cli:js:local": "DOTENV_CONFIG_PATH=.env.development node -r dotenv/config cli/upship.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint server/ cli/ --ext .js",
    "lint:fix": "eslint server/ cli/ --ext .js --fix",
    "code-cleanup": "eslint server/ cli/ --ext .js --rule 'sonarjs/no-identical-functions: error' --rule 'sonarjs/no-duplicated-branches: error' --rule 'sonarjs/cognitive-complexity: [warn, 20]'"
  },
  "bin": {
    "upship": "./cli/upship.js"
  },
  "keywords": [
    "boardgame",
    "airship",
    "strategy"
  ],
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4"
  }
}
