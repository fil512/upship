{
  "name": "upship",
  "version": "1.0.0",
  "description": "UP SHIP! - A strategy board game about airship conglomerates during the Golden Age of Airships",
  "main": "server/index.ts",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "start": "tsx server/index.ts",
    "build": "npm run build:api && npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "dev": "tsx watch server/index.ts",
    "dev:local": "DOTENV_CONFIG_PATH=.env.development tsx watch --env-file=.env.development server/index.ts",
    "dev:web": "npm run dev --workspace=web",
    "dev:all": "concurrently \"npm run dev:local\" \"npm run dev:web\"",
    "build:web": "npm run build --workspace=web",
    "migrate": "tsx server/db/migrate.ts",
    "migrate:down": "tsx server/db/migrate.ts down",
    "migrate:status": "tsx server/db/migrate.ts status",
    "migrate:local": "DOTENV_CONFIG_PATH=.env.development tsx --env-file=.env.development server/db/migrate.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "dev:setup": "npm run db:up && sleep 2 && npm run migrate:local && npm run dev:local",
    "cli": "client/.env/bin/python3 cli/upship_cli.py",
    "cli:local": "UPSHIP_URL=http://localhost:3000 client/.env/bin/python3 cli/upship_cli.py",
    "cli:js": "npx tsx cli/upship.ts",
    "cli:js:local": "DOTENV_CONFIG_PATH=.env.development npx tsx cli/upship.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint server/ cli/ --ext .js,.ts",
    "lint:fix": "eslint server/ cli/ --ext .js,.ts --fix",
    "code-cleanup": "eslint server/ cli/ --ext .js,.ts --rule 'sonarjs/no-identical-functions: error' --rule 'sonarjs/no-duplicated-branches: error' --rule 'sonarjs/cognitive-complexity: [warn, 20]'"
  },
  "bin": {
    "upship": "./cli/upship.ts"
  },
  "keywords": [
    "boardgame",
    "airship",
    "strategy"
  ],
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1",
    "xstate": "^5.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
