{
  "name": "upship-print",
  "version": "1.0.0",
  "description": "Print card generation for UP SHIP! board game",
  "type": "module",
  "scripts": {
    "generate": "node generate.js",
    "generate:agent": "node generate.js --type=agent",
    "generate:tech": "node generate.js --type=tech",
    "generate:hazard": "node generate.js --type=hazard",
    "generate:mission": "node generate.js --type=mission",
    "generate:tiles": "node generate.js --tiles-only",
    "generate:sheets": "node generate.js --sheets-only"
  },
  "dependencies": {
    "playwright": "^1.40.0"
  }
}
